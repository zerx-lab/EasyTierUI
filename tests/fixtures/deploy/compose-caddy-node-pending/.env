# EasyTierUI deployment: enrollment of this server's own node. Mode 0600; do not share, commit or paste it.
# Next to docker-compose.yml, chmod 600.
#
# The URL attaches the node to the easytier-web account "relay-7f3k2q" on this server. That account does not exist
# yet: register it through the SSH tunnel during first-run hardening (README.md), then start the node.
ET_CONFIG_SERVER=udp://127.0.0.1:22020/relay-7f3k2q
