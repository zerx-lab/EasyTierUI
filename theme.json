      "sidebar-primary-foreground": "#ffffff",
      "sidebar-accent": "var(--accent)",
      "sidebar-accent-foreground": "#16181d",
      "sidebar-border": "var(--border)",
      "sidebar-ring": "var(--primary)"
    },
    "dark": {
      "background": "#0c0e12",
      "foreground": "#eceef2",
      "card": "#14161b",
      "card-foreground": "#eceef2",
      "popover": "#181b21",
      "popover-foreground": "#eceef2",
      "primary": "#7896ff",
      "primary-foreground": "#0b1020",
      "primary-muted": "color-mix(in srgb, var(--primary) 10%, transparent)",
      "secondary": "#20232b",
      "secondary-foreground": "#eceef2",
      "muted": "#20232b",
      "muted-foreground": "#9aa1af",
      "accent": "#272b34",
      "accent-foreground": "#eceef2",
      "destructive": "#f0595e",
      "destructive-foreground": "#14070a",
      "destructive-muted": "color-mix(in srgb, var(--destructive) 10%, transparent)",
      "success": "#3fd394",
      "success-muted": "color-mix(in srgb, var(--success) 10%, transparent)",
      "warning": "#f0b546",
      "warning-muted": "color-mix(in srgb, var(--warning) 10%, transparent)",
