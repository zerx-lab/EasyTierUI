      "input": "#646a78",
      "ring": "var(--primary)",
      "chart-1": "#7896ff",
      "chart-2": "#2fd1b2",
      "chart-3": "#ab8cff",
      "chart-4": "#4cc0f0",
      "chart-5": "#9aa1af",
      "sidebar": "#111318",
      "sidebar-foreground": "#eceef2",
      "sidebar-primary": "var(--primary)",
      "sidebar-primary-foreground": "#0b1020",
      "sidebar-accent": "var(--accent)",
      "sidebar-accent-foreground": "#eceef2",
