{
  "name": "EasyTierUI",
  "cssVars": {
    "theme": {
      "radius": "0.5rem",
      "radius-control": "0.375rem"
    },
    "light": {
      "background": "#f6f7f9",
      "foreground": "#16181d",
      "card": "#ffffff",
      "card-foreground": "#16181d",
      "popover": "#ffffff",
      "popover-foreground": "#16181d",
      "primary": "#3156d3",
      "primary-foreground": "#ffffff",
      "primary-muted": "color-mix(in srgb, var(--primary) 10%, transparent)",
      "secondary": "#eceef2",
      "secondary-foreground": "#16181d",
      "muted": "#eceef2",
      "muted-foreground": "#5b616e",
      "accent": "#e4e7ec",
      "accent-foreground": "#16181d",
      "destructive": "#c1343a",
      "destructive-foreground": "#ffffff",
      "destructive-muted": "color-mix(in srgb, var(--destructive) 10%, transparent)",
      "success": "#146f46",
      "success-muted": "color-mix(in srgb, var(--success) 10%, transparent)",
      "warning": "#9a5b06",
      "warning-muted": "color-mix(in srgb, var(--warning) 10%, transparent)",
      "border": "#dfe2e8",
      "input": "#878d99",
      "ring": "var(--primary)",
      "chart-1": "#3156d3",
      "chart-2": "#0f8f7a",
      "chart-3": "#7a4fd0",
      "chart-4": "#0a7fb5",
      "chart-5": "#6b7280",
      "sidebar": "#eef0f3",
      "sidebar-foreground": "#16181d",
